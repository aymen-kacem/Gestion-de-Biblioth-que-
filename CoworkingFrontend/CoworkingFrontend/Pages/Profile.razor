@page "/profile"
@using CoworkingBlazor.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="container-fluid mt-4">
    <div class="panel">
        <h4 class="mb-3">Profile</h4>

        @if (!AuthService.IsAuthenticated)
        {
            <div class="alert alert-warning">You are not logged in. <a href="/login">Login</a></div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    <div class="form-control">@Username</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <div class="form-control">@UserRole</div>
                </div>

                <div class="col-12 mt-3">
                    <button class="btn btn-primary me-2" @onclick="GoDashboard">Go to Dashboard</button>
                    <button class="btn btn-outline-danger" @onclick="Logout">Logout</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string Username = string.Empty;
    private string UserRole = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            return;
        }

        Username = await AuthService.GetUsernameAsync();
        UserRole = await AuthService.GetRoleAsync();
    }

    private void GoDashboard() => NavigationManager.NavigateTo("/dashboard");

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}
